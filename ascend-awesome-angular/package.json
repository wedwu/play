{
  "name": "@trustage/ascend-awesome-angular",
  "version": "0.1.0",
  "description": "Angular reference application for the AscendAwesome design system, built on Web Awesome components.",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "typedoc",
    "storybook": "ng run ascend-awesome-angular:storybook",
    "build-storybook": "ng run ascend-awesome-angular:build-storybook",
    "sync:wa-assets": "node scripts/sync-wa-assets.mjs",
    "postinstall": "npm run sync:wa-assets",
    "verify": "npm run lint && npm run format:check && npm run build"
  },
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@awesome.me/webawesome": "3.13.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.8",
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/angular": "^10.6.0",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.8",
    "sass": "^1.104.1",
    "storybook": "^10.6.0",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
}
