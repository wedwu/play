{
  "name": "planning-poker-extension",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "package": "npm run build && tfx extension create --manifest-globs vss-extension.json",
    "package:dev": "npm run build && tfx extension create --manifest-globs vss-extension.json --override \"{\\\"public\\\":false}\"",
    "publish": "npm run build && tfx extension publish --manifest-globs vss-extension.json"
  },
  "dependencies": {
    "azure-devops-extension-sdk": "^4.0.2",
    "azure-devops-extension-api": "^4.232.0",
    "@microsoft/signalr": "^8.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.4.0",
    "ts-loader": "^9.5.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "html-webpack-plugin": "^5.6.0",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^6.10.0",
    "style-loader": "^3.3.4",
    "tfx-cli": "^0.17.0"
  }
}
